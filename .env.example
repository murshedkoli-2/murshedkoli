# Copy to .env.local. Never commit real credentials.
DATABASE_URL="mongodb://localhost:27017/portfolio?replicaSet=rs0"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin credentials; generate a unique long password and at least 32 random secret characters.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
NEXTAUTH_SECRET=""

# Shared rate limiting uses DATABASE_URL and creates _rate_limits + a TTL index.
# Set true ONLY behind an ingress that overwrites X-Forwarded-For.
# Vercel uses its platform-controlled X-Vercel-Forwarded-For header automatically.
TRUST_PROXY="false"

# AI providers are optional. Failures return an unavailable error, never fake results.
NVIDIA_API_KEY=""
NVIDIA_NIM_MODEL="meta/llama-3.2-11b-vision-instruct"
GOOGLE_AI_API_KEY=""
OPENROUTER_API_KEY=""

# Image uploads
IMGBB_API_KEY=""

# Certificate uploads (R2 is required for PDFs)
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""

# Optional: authenticated GitHub repository import
GITHUB_TOKEN=""
