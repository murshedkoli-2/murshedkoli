# ==============================================================================
# Portfolio Environment Variables Template (.env.example)
# Copy to .env.local and populate with your own values
# ==============================================================================

# ------------------------------------------------------------------------------
# Required Variables
# ------------------------------------------------------------------------------

# MongoDB Atlas or local MongoDB connection URI
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority"

# HMAC signing secret for session cookies (Web Crypto HMAC-SHA256)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-with-32-byte-base64-random-secret"

# Admin Credentials for /admin/login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-secure-password"

# Public site canonical base URL (used for metadata, JSON-LD, sitemap, robots)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Optional Variables (features degrade gracefully if omitted)
# ------------------------------------------------------------------------------

# ImgBB API Key (enables image uploads in the admin dashboard)
IMGBB_API_KEY=""

# Cloudflare R2 Storage (enables certificate PDF/image storage)
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""

# Google Gemini API Key (enables AI generation for project summaries, titles, SEO)
GOOGLE_AI_API_KEY=""

# OpenRouter API Key (fallback provider for AI generation)
OPENROUTER_API_KEY=""

# GitHub Personal Access Token (increases rate limits when importing repos via /admin/projects)
GITHUB_TOKEN=""
